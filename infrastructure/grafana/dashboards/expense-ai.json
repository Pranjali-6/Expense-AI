        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Transactions ingested by verdict",
      "description": "The confidence gate is min() of four dimensions, so 'flagged' and 'review_required' are the system saying which rows it is unsure about.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
