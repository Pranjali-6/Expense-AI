# =============================================================================
# Expense AI — environment configuration
#
# Copy to .env (or run `make init`, which also generates real secrets).
# NEVER commit .env.
#
# Comments live on their own lines. Trailing comments after a value are not
# stripped by `docker run --env-file`, so `FOO=bar  # note` sets FOO to
# "bar  # note" — a genuinely confusing way to lose an afternoon.
# =============================================================================

# --- Host port bindings -----------------------------------------------------
# Everything is reachable through nginx on http://localhost — these are direct
# conveniences only. Change any that clash with something else on your machine.
HTTP_HOST_PORT=80
API_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- Core -------------------------------------------------------------------
# development | staging | production
ENVIRONMENT=development
DEBUG=true
APP_NAME=Expense AI
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json

# --- Security ---------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Root key for per-tenant object-storage encryption (HKDF input).
# Generate with: openssl rand -hex 32
STORAGE_MASTER_KEK=CHANGE_ME_openssl_rand_hex_32

# Comma-separated.
CORS_ORIGINS=http://localhost,http://localhost:3000
# MUST be true in production (HTTPS only).
COOKIE_SECURE=false
COOKIE_DOMAIN=
CSRF_ENABLED=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_HOUR=60
RATE_LIMIT_ASSISTANT_PER_MINUTE=10

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=expense_ai
# Owner role — used only by migrations and init scripts.
POSTGRES_USER=expense_owner
POSTGRES_PASSWORD=CHANGE_ME_owner_password
# Least-privilege application role. Created NOSUPERUSER/NOBYPASSRLS so Row
# Level Security actually applies to it.
APP_DB_USER=expense_app
APP_DB_PASSWORD=CHANGE_ME_app_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis ------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CELERY_BROKER_DB=1
CELERY_RESULT_DB=2

# --- MinIO / object storage -------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_BUCKET_STATEMENTS=statements
MINIO_BUCKET_EXPORTS=exports
MINIO_SECURE=false
PRESIGNED_URL_TTL_SECONDS=300

# --- Upload limits ----------------------------------------------------------
MAX_UPLOAD_SIZE_MB=25
MAX_UPLOAD_FILES=20
MAX_PDF_PAGES=300
ALLOWED_UPLOAD_MIME=application/pdf

# --- Malware scanning (optional; compose profile "security") -----------------
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- OCR --------------------------------------------------------------------
OCR_ENABLED=true
OCR_LANGUAGES=eng
OCR_DPI=300
# Pages with fewer extractable characters than this are treated as scanned and
# routed to OCR. A page with a real text layer clears this easily; a scan
# produces single digits.
OCR_MIN_CHARS_PER_PAGE=100

# --- AI ---------------------------------------------------------------------
# The platform is FULLY FUNCTIONAL with AI_ENABLED=false. Deterministic rules
# handle categorization and AI-tier results route to the review queue instead.
AI_ENABLED=false
# gemini is the only provider implemented in the MVP.
AI_PROVIDER=gemini
AI_MODEL_CATEGORIZE=gemini-2.0-flash
AI_MODEL_ASSISTANT=gemini-2.0-flash
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_MONTHLY_BUDGET_INR=500
GEMINI_API_KEY=

# --- Confidence gating ------------------------------------------------------
# Gate is min() of the four dimensions, never an average.
CONFIDENCE_AUTO_APPROVE=0.97
CONFIDENCE_REVIEW_REQUIRED=0.90

# --- Google OAuth (disabled by default; needs your own credentials) ----------
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/v1/auth/oauth/google/callback

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_APP_NAME=Expense AI
NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_LOCALE=en-IN

# --- Observability (compose profile "observability") ------------------------
METRICS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# --- Data retention ---------------------------------------------------------
# ~7 years, matching Indian record-keeping norms.
STATEMENT_RETENTION_DAYS=2555
AUDIT_LOG_RETENTION_DAYS=2555
JOB_EVENT_RETENTION_DAYS=90
